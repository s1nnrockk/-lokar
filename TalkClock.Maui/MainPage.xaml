<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TalkClock.MainPage" BackgroundColor="#07111F">
  <ScrollView>
    <VerticalStackLayout Padding="22,26,22,36" Spacing="16">
      <Label Text="T A L K C L O C K" TextColor="#8DD7FF" FontSize="12" FontAttributes="Bold" />
      <Label Text="Your time,&#10;beautifully." TextColor="White" FontSize="34" FontAttributes="Bold"/>
      <Border Background="#142235" Stroke="#29425C" StrokeThickness="1" StrokeShape="RoundRectangle 28" Padding="22">
        <VerticalStackLayout Spacing="8">
          <Label Text="LOCAL TIME" TextColor="#91A8C0" FontSize="11" />
          <Label x:Name="ClockLabel" Text="00:00:00" TextColor="White" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center"/>
          <Label x:Name="DateLabel" Text="Monday, January 1" TextColor="#91A8C0" HorizontalOptions="Center"/>
        </VerticalStackLayout>
      </Border>
      <Border Background="#142235" Stroke="#29425C" StrokeShape="RoundRectangle 22" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="ALARMS" TextColor="#8DD7FF" FontAttributes="Bold"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TimePicker x:Name="AlarmTimePicker" Time="07:00:00" TextColor="White" />
            <Entry x:Name="AlarmLabelEntry" Grid.Column="1" Placeholder="Label" Text="Alarm" TextColor="White" PlaceholderColor="#91A8C0"/>
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">
            <VerticalStackLayout><CheckBox x:Name="Day0" Color="#8DD7FF"/><Label Text="Su" TextColor="#91A8C0" FontSize="11" HorizontalOptions="Center"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1"><CheckBox x:Name="Day1" Color="#8DD7FF"/><Label Text="Mo" TextColor="#91A8C0" FontSize="11" HorizontalOptions="Center"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2"><CheckBox x:Name="Day2" Color="#8DD7FF"/><Label Text="Tu" TextColor="#91A8C0" FontSize="11" HorizontalOptions="Center"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3"><CheckBox x:Name="Day3" Color="#8DD7FF"/><Label Text="We" TextColor="#91A8C0" FontSize="11" HorizontalOptions="Center"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="4"><CheckBox x:Name="Day4" Color="#8DD7FF"/><Label Text="Th" TextColor="#91A8C0" FontSize="11" HorizontalOptions="Center"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="5"><CheckBox x:Name="Day5" Color="#8DD7FF"/><Label Text="Fr" TextColor="#91A8C0" FontSize="11" HorizontalOptions="Center"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="6"><CheckBox x:Name="Day6" Color="#8DD7FF"/><Label Text="Sa" TextColor="#91A8C0" FontSize="11" HorizontalOptions="Center"/></VerticalStackLayout>
          </Grid>
          <Button Text="＋ Add alarm" Clicked="OnSetAlarmClicked" BackgroundColor="#8DD7FF" TextColor="#07111F" CornerRadius="16"/>
          <Label x:Name="AlarmStatus" Text="No alarms scheduled" TextColor="#91A8C0" FontSize="12"/>
          <VerticalStackLayout x:Name="AlarmList" Spacing="8"/>
        </VerticalStackLayout>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Background="#142235" Stroke="#29425C" StrokeShape="RoundRectangle 22" Padding="16">
          <VerticalStackLayout Spacing="10">
            <Label Text="TIMER" TextColor="#8DD7FF" FontAttributes="Bold"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <Entry x:Name="TimerMinutes" Placeholder="Min" Keyboard="Numeric" Text="5" TextColor="White" PlaceholderColor="#91A8C0"/>
              <Entry x:Name="TimerSeconds" Grid.Column="1" Placeholder="Sec" Keyboard="Numeric" Text="0" TextColor="White" PlaceholderColor="#91A8C0"/>
            </Grid>
            <Button x:Name="TimerButton" Text="Start timer" Clicked="OnTimerClicked" BackgroundColor="#8DD7FF" TextColor="#07111F" CornerRadius="16"/>
            <Label x:Name="TimerStatus" Text="Ready" TextColor="#91A8C0" FontSize="12"/>
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="1" Background="#142235" Stroke="#29425C" StrokeShape="RoundRectangle 22" Padding="16">
          <VerticalStackLayout Spacing="10">
            <Label Text="STOPWATCH" TextColor="#8DD7FF" FontAttributes="Bold"/>
            <Label x:Name="StopwatchLabel" Text="00:00.00" TextColor="White" FontSize="30" HorizontalOptions="Center"/>
            <Button x:Name="StopwatchButton" Text="Start" Clicked="OnStopwatchClicked" BackgroundColor="#8DD7FF" TextColor="#07111F" CornerRadius="16"/>
            <Button Text="Reset" Clicked="OnStopwatchResetClicked" BackgroundColor="#29425C" TextColor="White" CornerRadius="16"/>
            <Button Text="Lap" Clicked="OnLapClicked" BackgroundColor="#29425C" TextColor="White" CornerRadius="16"/>
          </VerticalStackLayout>
        </Border>
      </Grid>
      <VerticalStackLayout x:Name="LapList" Spacing="4"/>
      <Label Text="Offline • No ads • No account" TextColor="#526A83" FontSize="12" HorizontalOptions="Center"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>